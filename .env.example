# AttendX AI — copy to .env and replace every value. Never commit a real .env.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------------
# Local development without PostgreSQL:
DATABASE_URL=sqlite:///./attendx_dev.db
# Production / Docker:
# DATABASE_URL=postgresql+psycopg://attendx:CHANGE_ME@db:5432/attendx

# ---- Secrets --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
QR_SIGNING_KEY=CHANGE_ME_generate_a_separate_random_secret

# ---- Web / cookies --------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# ---- Bootstrap (development only; remove after first sign-in) -------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Institutional Administrator

# ---- Verification providers (none = honestly unavailable) -----------------
FACE_PROVIDER=none
FACE_HTTP_URL=
FACE_HTTP_TOKEN=
LIVENESS_PROVIDER=none
LIVENESS_HTTP_URL=
LIVENESS_HTTP_TOKEN=

# ---- Attendance defaults --------------------------------------------------
DEFAULT_ATTENDANCE_WINDOW_SECONDS=180
DEFAULT_QR_REFRESH_SECONDS=30
QR_GRACE_SECONDS=15
PIN_LENGTH=6
PIN_MAX_ATTEMPTS=5
