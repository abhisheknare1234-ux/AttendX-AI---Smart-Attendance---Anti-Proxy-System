# AttendX AI — copy to .env and replace every value. Never commit a real .env.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------------
# Local development without PostgreSQL:
DATABASE_URL=sqlite:///./attendx_dev.db
# Production / Docker:
# DATABASE_URL=postgresql+psycopg://attendx:CHANGE_ME@db:5432/attendx

# ---- Secrets --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
QR_SIGNING_KEY=CHANGE_ME_generate_a_separate_random_secret

# ---- Web / cookies --------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# ---- Bootstrap (development only; remove after first sign-in) -------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Institutional Administrator

# ---- Verification providers (none = honestly unavailable) -----------------
# Face: none | http | local_opencv
# local_opencv uses YuNet + SFace models downloaded with
#   python -m app.scripts.download_face_models
FACE_PROVIDER=none
FACE_MODEL_DIR=models
FACE_MATCH_THRESHOLD=0.363
FACE_DETECTION_THRESHOLD=0.7
# Separate key for encrypting face templates; generated like SECRET_KEY.
# Falls back to SECRET_KEY when empty (rotating SECRET_KEY invalidates templates).
FACE_TEMPLATE_KEY=
FACE_HTTP_URL=
FACE_HTTP_TOKEN=

# Liveness: none | http | local_minifas
# local_minifas runs a single-frame MiniFASNet anti-spoof classifier.
# It is not a challenge-response protocol and is not proof of a live person.
LIVENESS_PROVIDER=none
LIVENESS_MODEL_DIR=models
LIVENESS_THRESHOLD=0.0
LIVENESS_HTTP_URL=
LIVENESS_HTTP_TOKEN=

# ---- Attendance defaults --------------------------------------------------
DEFAULT_ATTENDANCE_WINDOW_SECONDS=180
DEFAULT_QR_REFRESH_SECONDS=30
QR_GRACE_SECONDS=15
PIN_LENGTH=6
PIN_MAX_ATTEMPTS=5
